{
    "name": "kkxdev/laravel-collective-html-spatie-html-bridge",
    "description": "LaravelCollective/HTML compatibility wrapper backed by Spatie Laravel HTML — preserves existing Blade templates while migrating off laravelcollective/html.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "html", "form", "laravelcollective", "spatie", "compatibility", "migration"],
    "authors": [
        {
            "name": "kkxdev",
            "email": "kkxdev@outlook.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^8.0|^9.0",
        "illuminate/http": "^8.0|^9.0",
        "illuminate/routing": "^8.0|^9.0",
        "illuminate/session": "^8.0|^9.0",
        "spatie/laravel-html": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "orchestra/testbench": "^6.0",
        "mockery/mockery": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Kkxdev\\HtmlCompat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kkxdev\\HtmlCompat\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kkxdev\\HtmlCompat\\HtmlCompatServiceProvider"
            ],
            "aliases": {
                "Form": "Kkxdev\\HtmlCompat\\Facades\\Form",
                "Html": "Kkxdev\\HtmlCompat\\Facades\\Html"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "audit": {
            "ignore": ["PKSA-8qx3-n5y5-vvnd"]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
