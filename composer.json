{
    "name": "kkxdev/laravel-collective-html-spatie-html-bridge",
    "description": "LaravelCollective/HTML compatibility wrapper backed by Spatie Laravel HTML — preserves existing Blade templates while migrating off laravelcollective/html.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/kkxdev/laravel-collective-html-spatie-html-bridge",
    "keywords": [
        "laravel",
        "html",
        "form",
        "forms",
        "laravelcollective",
        "laravel-collective",
        "spatie",
        "spatie-html",
        "compatibility",
        "bridge",
        "migration",
        "shift",
        "blade"
    ],
    "authors": [
        {
            "name": "kkxdev",
            "email": "kkxdev@outlook.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/session": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "spatie/laravel-html": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5|^10.0|^11.0|^12.0",
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "mockery/mockery": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Kkxdev\\HtmlCompat\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Kkxdev\\HtmlCompat\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kkxdev\\HtmlCompat\\HtmlCompatServiceProvider"
            ],
            "aliases": {
                "Form": "Kkxdev\\HtmlCompat\\Facades\\Form",
                "Html": "Kkxdev\\HtmlCompat\\Facades\\Html"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/kkxdev/laravel-collective-html-spatie-html-bridge/issues",
        "source": "https://github.com/kkxdev/laravel-collective-html-spatie-html-bridge"
    },
    "conflict": {
        "laravelcollective/html": "*"
    },
    "scripts": {
        "test": "phpunit"
    }
}
